node_modules/
*.log

# Generated Netlify preview build artifact (delivered directly, not versioned)
rounds-codex-usmle-preview.zip

# raw generated images awaiting QA (not versioned)
tools/candidates/*
!tools/candidates/.gitkeep

# live app working copy (PRIVATE — never commit to this public repo)
applive/

# private live-app deploy bundles (delivered to user, never commit to public repo).
# This was an enumerated list of four prefixes, which CLAUDE.md described as excluding
# "every rounds-codex-*.zip deploy bundle" -- it did not, and the first bundle with a new
# name (rounds-codex-calc-fix.zip) landed unignored in a PUBLIC repo carrying the live
# app's index.html. One glob instead of a list that has to be remembered.
rounds-codex-*.zip

# staging folders for those bundles: the files inside are the live app, not source
deploy/*/

# Raw incoming gallery batches (196 MB for the 2026-07-31 neurology drop alone).
# The pages get built into assets/ and gthumbs/ at 1024x1536 q88; the raw upload
# dump is an input, not source. The mapping that IS worth keeping is committed
# alongside as a .json.
galleries-staging/_incoming-*/
__pycache__/
*.pyc
